# ---- Public site config (safe to expose) ----
NEXT_PUBLIC_SITE_URL=https://algoroasts.com
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4557897331416844

# ---- Manual AdSense units (optional) ----
# Paste the 10-digit data-ad-slot IDs from AdSense → Ads → By ad unit.
# Leave empty and the manual units render NOTHING; Auto ads (dashboard toggle) serve meanwhile.
NEXT_PUBLIC_AD_SLOT_IN_ARTICLE_TOP=
NEXT_PUBLIC_AD_SLOT_IN_ARTICLE_MID=
NEXT_PUBLIC_AD_SLOT_IN_FEED=
NEXT_PUBLIC_AD_SLOT_IN_FEED_LAYOUT_KEY=
NEXT_PUBLIC_AD_SLOT_DISPLAY=
NEXT_PUBLIC_AD_SLOT_TOOL_RESULT=

# ---- Invite list + contact form (server-only, never prefix with NEXT_PUBLIC_) ----
# Where /api/leads forwards submissions. Easiest: deploy scripts/leads-webhook.gs as a
# Google Apps Script web app and paste its /exec URL here.
LEADS_WEBHOOK_URL=
# Any long random string. Sent as an HMAC signature so the receiver can reject forged posts.
LEADS_WEBHOOK_SECRET=
